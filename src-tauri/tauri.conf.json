{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Shift",
  "version": "0.7.4",
  "identifier": "com.dzarel.shift",
  "plugins": {
    "shell": {
      "open": true
    },
    "globalShortcut": {},
    "updater": {
      "endpoints": [
        "https://github.com/DzarelDeveloper/Shift/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExMzY5MDAyQTJCMTNFMzcKUldRM1ByR2lBcEEyb1Z2L3o0M1JjUXlKUEF6dUFIVlY5ckZpUkNIbmd5cTJjN09aemg5d3RSWUEK",
      "windows": {
        "installMode": "nsis"
      },
      "macOS": {
        "installMode": "bundle"
      }
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shift",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "launcher",
        "title": "Shift Launcher",
        "width": 700,
        "height": 450,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https:; style-src 'self' 'unsafe-inline';"
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}