{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Shift app",
  "permissions": [
    "core:default",
    "shell:default",
    "shell:allow-open",
    "global-shortcut:default",
    "autostart:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "dialog:default"
  ]
}
